# OAI PayPal standalone - sanitized defaults
OPLL_WEB_PASSWORD=
OPLL_AT=
OPLL_CHECKOUT_PROXY=
OPLL_UPDATE_PROXY=
OPLL_STRIPE_HCAPTCHA_TOKEN=

# ChatGPT browser-checkout compatibility (all optional; never commit live values)
OPLL_HTTP_IMPERSONATE=chrome
OPLL_OAI_CLIENT_BUILD_NUMBER=
OPLL_OAI_CLIENT_VERSION=
OPLL_OAI_WEB_DEPLOYMENT_ATTESTATION=
OPLL_OPENAI_SENTINEL_TOKEN=
OPLL_OPENAI_SENTINEL_SO_TOKEN=
OPLL_OAI_IS_CLIENT_OBSERVATION=
OPLL_X_OAI_IS_PENDING_UPDATES=
# GoPay Sentinel uses a real persistent Playwright-controlled Chrome profile.
OPLL_SENTINEL_BROWSER=auto
OPLL_SENTINEL_HEADLESS=false
OPLL_GOPAY_SENTINEL_BROWSER_CHANNEL=chrome
OPLL_GOPAY_SENTINEL_NAVIGATE_CHECKOUT=true
OPLL_GOPAY_SENTINEL_PROFILE_DIR=./data/gopay-sentinel-profiles
# Attach GoPay Sentinel to an already logged-in Chrome/Roxy CDP browser. Leave
# blank to use the isolated persistent profile path above.
OPLL_GOPAY_SENTINEL_CDP_PORT=
# Keep the attached browser's single network route across all GoPay phases.
OPLL_GOPAY_EXTERNAL_CDP_ALLOW_PROXY_ROTATION=false
# Route ChatGPT protected mutations through the attached browser's real
# network/proxy so Sentinel and approval share one egress.
OPLL_GOPAY_EXTERNAL_CDP_BROWSER_HTTP=true
# Match Chrome's snapshot/taxes observation burst; disable only for diagnostics.
OPLL_GOPAY_BURST_OBSERVATION=true
# Reclaim regenerable Chromium model/cache payloads after isolated runs while
# retaining cookie, Login Data and other session-bearing profile files.
OPLL_GOPAY_PROFILE_CACHE_CLEANUP=true
# Optional cccy-compatible GoPay route segments. Blank keeps A/A/A/A on the
# selected attempt proxy; set explicitly only when each ID segment is sticky.
OPLL_GOPAY_CHECKOUT_PROXY=
OPLL_GOPAY_PROMOTION_PROXY=
OPLL_GOPAY_PROVIDER_PROXY=
OPLL_GOPAY_APPROVE_PROXY=
# MK GCash runtime: prewarm its shared Playwright Chromium and bound only the
# dead-proxy TCP connect phase. The upstream 30-second request timeout remains.
MK_GCASH_PREWARM=true
MK_GCASH_CONNECT_TIMEOUT_MS=8000
# GCash accepts host:port:user:pass, socks5://host:port, and authenticated
# socks5://user:pass@host:port (the latter is bridged to local HTTP CONNECT).
OPLL_USER_AGENT=
OPLL_OAI_LANGUAGE=en-US
OPLL_GOPAY_OAI_LANGUAGE=id-ID
OPLL_SEC_CH_UA=
OPLL_SEC_CH_UA_PLATFORM=

# EUR billing
# Fallback used only when the workbench sends no billing country.
OPLL_COUNTRY=DE
OPLL_PAYMENT_METHOD=paypal
OPLL_UPDATE_CHECKOUT=true
OPLL_GOPAY_ZERO_TRIAL_VALIDATION=true

# Local service
OPLL_WEB_HOST=127.0.0.1
OPLL_WEB_PORT=18794
OPLL_TASK_WORKERS=4
OPLL_TASK_MAX_WORKERS=10
OPLL_TASK_TTL_SECONDS=3600
OPLL_TASK_EVENT_HISTORY_SIZE=500

# Optional IPRocket subscription URL; blank by default
OPLL_PROXY_SOURCE_URL=
OPLL_PROXY_POOL_FILE=
IPROCKET_CHAIN_PROXY=http://127.0.0.1:18796
IPROCKET_BRIDGE_PORT=18796

# PayPal protocol country/proxy/browser compatibility
PAYPAL_WEB_ENABLE_DYNAMIC_COUNTRIES=1
PAYPAL_PROXY_USE_BRIDGE=1
PAYPAL_BROWSER_EXECUTABLE=

OPLL_LOG_LEVEL=INFO
OPLL_LOG_FILE=./data/payment-link.log
OPLL_LOG_JSON=false

# HeroSMS automatic country-matched phone/SMS retrieval (keep key only in local .env)
HEROSMS_API_KEY=
HEROSMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
HEROSMS_SERVICE=paypal
HEROSMS_MAX_PRICE=
HEROSMS_POLL_INTERVAL=5
HEROSMS_TIMEOUT=1800
