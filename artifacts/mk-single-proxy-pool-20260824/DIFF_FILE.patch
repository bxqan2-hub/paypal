--- a/payment_link_extractor/web/static/styles.css
+++ b/payment_link_extractor/web/static/styles.css
@@ -1,6 +1,11 @@
 :root {
-  color: #17202a;
-  background: #f4f6f8;
+  --mk-accent: #6847dc;
+  --mk-accent-dark: #5536bf;
+  --mk-surface: #ffffff;
+  --mk-bg: #f6f4fb;
+  --mk-border: #e8e2f3;
+  color: #292632;
+  background: var(--mk-bg);
   font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
   font-size: 16px;
   line-height: 1.5;
@@ -10,13 +15,13 @@
 
 [hidden] { display: none !important; }
 
-body { margin: 0; min-width: 320px; }
+body { margin: 0; min-width: 320px; background: radial-gradient(circle at 12% 0, #eee8ff 0, transparent 28rem), var(--mk-bg); }
 
 button, input, select, textarea { font: inherit; }
 
 button { cursor: pointer; }
 
-.shell { width: 100%; max-width: none; margin: 0; padding: 36px 24px 64px; }
+.shell { width: 100%; max-width: 1560px; margin: 0 auto; padding: 24px 24px 64px; }
 
 .auth-gate {
   position: fixed;
@@ -33,13 +38,17 @@ button { cursor: pointer; }
 .auth-card > p:not(.eyebrow) { margin-bottom: 20px; color: #75808c; font-size: 13px; }
 .auth-card .primary { width: 100%; margin-top: 16px; }
 
-.workspace-grid { display: grid; grid-template-columns: minmax(260px, .62fr) minmax(0, 2fr); gap: 24px; align-items: start; }
+.workspace-grid { display: grid; grid-template-columns: minmax(330px, .78fr) minmax(0, 1.8fr); gap: 24px; align-items: start; }
 
 .topbar, .panel-heading, .section-heading, .form-actions, .task-header, .task-footer, .result-row {
   display: flex; align-items: center; justify-content: space-between; gap: 16px;
 }
 
-.topbar { margin-bottom: 28px; }
+.topbar { margin-bottom: 24px; padding: 14px 18px; border: 1px solid var(--mk-border); border-radius: 16px; background: rgba(255,255,255,.88); box-shadow: 0 12px 36px rgba(74,49,140,.07); backdrop-filter: blur(12px); }
+.mk-brand { display: flex; align-items: center; gap: 11px; }
+.mk-brand img { border-radius: 10px; box-shadow: 0 5px 14px rgba(104,71,220,.18); }
+.mk-brand h1 { font-size: 22px; }
+.mk-brand h1 span { color: var(--mk-accent); font-size: 12px; font-weight: 750; vertical-align: middle; }
 .topbar-actions { display: flex; align-items: center; gap: 12px; }
