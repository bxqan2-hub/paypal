+class PayPalTransportError(RuntimeError):
+    """Typed network failure with a redacted request target.
+
+    The previous session layer leaked a raw curl exception to every caller.
+    That made timeout and proxy-CONNECT failures indistinguishable from an
+    application/GraphQL error in job diagnostics.  The original exception is
+    retained as ``__cause__`` while the public text contains only the method,
+    host/path and curl error family.
+    """
+
+    error_code = "PAYPAL_TRANSPORT_ERROR"
+
+    def __init__(self, method: str, url: str, cause: BaseException) -> None:
+        self.method = str(method or "GET").upper()
+        parsed = urlsplit(str(url or ""))
+        self.target = f"{parsed.scheme}://{parsed.netloc}{parsed.path}" if parsed.netloc else parsed.path
+        text = str(cause or type(cause).__name__)
+        text = re.sub(r"([a-z][a-z0-9+.-]*://)[^/@\s]+@", r"\1***@", text, flags=re.I)
+        code_match = re.search(r"curl:\s*\((\d+)\)", text, re.I)
+        self.transport_code = f"curl_{code_match.group(1)}" if code_match else type(cause).__name__
+        super().__init__(
+            f"{self.error_code}: {self.method} {self.target or '<unknown>'}; "
+            f"kind={self.transport_code}; {text}"
+        )
+
+
