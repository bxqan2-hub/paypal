+        "Session",
+        (),
+        {"headers": {}, "openai_sentinel_observer_enabled": False},
+    )()
+
+    def fake_eval(expression, timeout=75):
+        if "SentinelSDK.token" in expression:
+            events.append("token")
+            return {
+                "token": "proof-fixture",
+                "timing": "[1,620.5,7,30,26,2,0,624]",
