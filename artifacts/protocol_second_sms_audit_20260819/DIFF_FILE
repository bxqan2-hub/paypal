+def duplicate_phone_indexes(values: list[str]) -> list[int]:
+    """Return zero-based duplicate positions using a formatting-neutral key."""
+    seen: set[str] = set()
+    duplicates: list[int] = []
+    for index, value in enumerate(values):
+        phone_key = "".join(char for char in str(value or "") if char.isdigit())
+        if not phone_key:
+            continue
+        if phone_key in seen:
+            duplicates.append(index)
+        else:
+            seen.add(phone_key)
+    return duplicates
+
