+        "checkout_amount": "2000",
+    }
+    billing = {
+        "name": "Test User",
+        "email": "test@example.com",
+        "line1": "1 Test Street",
+        "city": "London",
+        "postal_code": "SW1A 1AA",
+        "country": "GB",
+        "state": "",
+    }
+
+    result = cs_live.stripe_confirm_cs_live(
+        object(),
