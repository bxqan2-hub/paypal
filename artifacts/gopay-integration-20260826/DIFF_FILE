+        "init_checksum": str(payload.get("init_checksum") or ""),
+        "checkout_amount": 0,
+        "runtime_version": DEFAULT_STRIPE_RUNTIME_VERSION,
+        "stripe_version": STRIPE_VERSION,
+    }
+    return payload, ctx
