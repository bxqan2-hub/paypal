+def validate_tls_ua_consistency(impersonate: str, user_agent: str) -> bool:
+    """Reject explicit Chrome TLS/UA version mismatches before a request."""
+    tls_match = re.search(r"chrome(\d+)$", str(impersonate or "").lower())
