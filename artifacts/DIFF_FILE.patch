+            r'\\"contentIdentifier\\"\s*:\s*\\"([^"\\]*signupTerms[^"\\]*)\\"',
+            r'([A-Z]{2}:[a-z]{2}:[0-9a-f]{16,64}:compliance\.signupTerms)',
+        ):
+            match = re.search(pattern, html or "", re.I)
+            if match:
+                return match.group(1).replace("\\/", "/")
+        return f"{country}:{lang}:compliance.signupTerms"
