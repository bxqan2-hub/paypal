+    return parsed.searchParams.get('PayerID') || parsed.searchParams.get('payerId') || parsed.searchParams.get('payer_id') || '';
+  } catch (_) {
+    const match = raw.match(/(?:PayerID|payerId|payer_id)=([^&#\s]+)/i);
+    return match ? decodeURIComponent(match[1]) : raw;
+  }
+}
