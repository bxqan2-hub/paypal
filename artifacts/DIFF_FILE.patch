+                runtime_schema, self.user.phone_local, self.user.phone
+            )
+            runtime_schema["phone_validation_error"] = phone_error
+            if phone_error:
+                raise RuntimeError(f"RUNTIME_PHONE_VALIDATION_FAILED: {phone_error}")
