+                gcash_chain.CHECKOUT_BASE,
+                gcash_chain.CHECKOUT_BASE,
+                f"{gcash_chain.CHECKOUT_BASE}/taxes",
+                f"{gcash_chain.CHECKOUT_BASE}/confirm",
+                f"{gcash_chain.CHECKOUT_BASE}/custom_payment_method/start",
