+        self.assertTrue(create["body"]["promo_campaign"]["is_coupon_from_query_param"])
+        self.assertTrue(create["body"]["check_card_proxy"])
+        self.assertEqual({"country": "PH", "currency": "PHP"}, create["body"]["billing_details"])
+        self.assertEqual(
