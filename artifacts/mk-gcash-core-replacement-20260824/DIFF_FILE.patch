+        )
+
+        first_create, create, taxes, confirm, start = requests
+        self.assertNotIn("OpenAI-Sentinel-Token", first_create["headers"])
+        self.assertEqual("fixture-account", create["headers"]["ChatGPT-Account-Id"])
+        self.assertEqual(
