from __future__ import annotations

import asyncio
import os
import secrets
import threading
import time
from typing import Any, Callable

from gcash_chain import GCashChain, _retry_decision
from curl_cffi import CurlOpt
from payment_monitor import manager as payment_monitor

from .auth import decode_jwt_payload
from .errors import ExtractionCancelled, ProtocolError
from .models import BillingProfile, ExtractionConfig, PaymentLinkResult


MK_GCASH_SOURCE_COMMIT = "2607d879ce2005ef9a9c6cdfa1ec747c6f26d4d5"

_STAGE_MAP = {
    "proxy_test": "eligibility_check",
    "create_checkout": "checkout",
    "configure_taxes": "taxes",
    "confirm_payment": "payment_confirmation",
    "start_payment": "payment_confirmation",
    "follow_redirect": "redirect_resolution",
}


def _as_int(value: Any) -> int:
    try:
        return max(0, int(value))
    except (TypeError, ValueError):
        return 0


def _connect_timeout_ms() -> int:
    try:
        return max(3_000, min(int(os.getenv("MK_GCASH_CONNECT_TIMEOUT_MS", "8000")), 15_000))
    except (TypeError, ValueError):
        return 8_000


def _upstream_account(config: ExtractionConfig) -> tuple[str, str, str]:
    """Apply MK app.py's explicit/JWT account metadata and expiry rules."""
    payload = decode_jwt_payload(config.access_token)
    profile = payload.get("https://api.openai.com/profile")
    auth = payload.get("https://api.openai.com/auth")
    profile = profile if isinstance(profile, dict) else {}
    auth = auth if isinstance(auth, dict) else {}
    expires_at = payload.get("exp")
    try:
        expires_at = int(expires_at) if expires_at is not None else None
    except (TypeError, ValueError):
        expires_at = None
    if expires_at is not None and expires_at <= int(time.time()):
        raise ProtocolError(401, "AT 已过期")
    email = str(
        config.account_email
        or profile.get("email")
        or payload.get("email")
        or payload.get("preferred_username")
        or ""
    ).strip()
    name = str(
        config.account_name
        or profile.get("name")
        or payload.get("name")
        or payload.get("given_name")
        or ""
    ).strip()
    token_account_id = str(
        auth.get("chatgpt_account_id")
        or payload.get("chatgpt_account_id")
        or payload.get("account_id")
        or ""
    ).strip()
    return token_account_id, email, name


def _upstream_billing(email: str, name: str) -> BillingProfile:
    # MK sends only checkout_email, billing_name, country=PH and tax_id=None.
    # Keep absent address fields absent instead of injecting the site's former
    # synthetic Philippine identity.
    return BillingProfile(
        name=name or "GCash User",
        email=email,
        phone="",
        country="PH",
        line1="",
        city="",
        state="",
        postal_code="",
    )


def _apply_connect_timeout(chain: GCashChain) -> int:
    timeout_ms = _connect_timeout_ms()
    session = getattr(chain, "_session", None)
    options = getattr(session, "curl_options", None)
    if isinstance(options, dict):
        options[CurlOpt.CONNECTTIMEOUT_MS] = timeout_ms
    return timeout_ms


def prewarm_mk_gcash_runtime(timeout: float = 20.0) -> str:
    """Launch the upstream shared Chromium before the first GCash task."""
    payment_monitor._ensure_loop()
    future = asyncio.run_coroutine_threadsafe(
        payment_monitor._get_browser(), payment_monitor._loop
    )
    browser = future.result(timeout=max(1.0, float(timeout)))
    return str(browser.version)


def extract_mk_gcash_payment_link(
    config: ExtractionConfig,
    *,
    cancel_event: threading.Event | None = None,
    stage_callback: Callable[[str], None] | None = None,
) -> PaymentLinkResult:
    """Run the vendored MK GCash core and adapt its result to this application."""
    token_account_id, email, name = _upstream_account(config)
    billing = _upstream_billing(email, name)
    last_stage = ""
    started_at = time.perf_counter()
    stage_offsets_ms: dict[str, int] = {}

    def cancelled() -> bool:
        return bool(cancel_event is not None and cancel_event.is_set())

    def on_update(snapshot: dict[str, Any]) -> None:
        nonlocal last_stage
        upstream_stage = str(snapshot.get("current_step") or "")
        if upstream_stage and upstream_stage not in stage_offsets_ms:
            stage_offsets_ms[upstream_stage] = round((time.perf_counter() - started_at) * 1000)
        stage = _STAGE_MAP.get(upstream_stage, "")
        if stage and stage != last_stage and stage_callback is not None:
            last_stage = stage
            stage_callback(stage)

    chain = GCashChain(
        token=config.access_token,
        client_account_id="acct_" + secrets.token_hex(8),
        account_id=token_account_id,
        billing_email=email,
        billing_name=name,
        proxy=config.checkout_proxy,
        on_update=on_update,
        cancel_check=cancelled,
    )
    # Keep the upstream 30-second request deadline, but cap only the TCP proxy
    # connect phase. Dead pool entries previously consumed 30 seconds apiece.
    connect_timeout_ms = _apply_connect_timeout(chain)
    result = chain.run()
    if str(result.get("status") or "") != "success":
        detail = str(result.get("error_message") or "GCash extraction failed")
        if cancelled() or "TASK_CANCELLED" in detail:
            raise ExtractionCancelled("task cancellation requested")
        retryable, retry_reason = _retry_decision(result)
        error = ProtocolError(502, detail)
        error.mk_retryable = bool(retryable)  # type: ignore[attr-defined]
        error.mk_retry_reason = str(retry_reason or "")  # type: ignore[attr-defined]
        error.mk_stage_offsets_ms = dict(stage_offsets_ms)  # type: ignore[attr-defined]
        error.mk_elapsed_ms = round((time.perf_counter() - started_at) * 1000)  # type: ignore[attr-defined]
        raise error

    gcash_url = str(result.get("gcash_url") or "")
    if not gcash_url:
        raise ProtocolError(502, "MK GCash core returned success without gcash_url")

    amount_minor = _as_int(chain.checkout_amount)
    adapted = PaymentLinkResult(
        checkout_session_id=str(chain.cid or ""),
        session_kind="openai_custom_checkout",
        payment_method="gcash",
        billing_country="PH",
        currency="PHP",
        amount_due=amount_minor / 100,
        amount_due_minor=amount_minor,
        billing=billing,
        account_email=email,
        payment_method_id=str(chain.cpmt or ""),
        stripe_redirect_url=str(chain.adyen_url or ""),
        provider_url=gcash_url,
        provider_field="gcash_url",
        provider_value=gcash_url,
        extra={
            "mk_gcash_source_commit": MK_GCASH_SOURCE_COMMIT,
            "payment_route": str(result.get("payment_route") or ""),
            "qr_text": str(result.get("qr_text") or ""),
            "qr_short": str(result.get("qr_short") or ""),
            "net_auth_id": str(result.get("net_auth_id") or ""),
            "qr_expires_at": result.get("qr_expires_at"),
            "monitor_id": str(result.get("monitor_id") or ""),
            "callback_status": str(result.get("callback_status") or ""),
            "stage_offsets_ms": stage_offsets_ms,
            "total_elapsed_ms": round((time.perf_counter() - started_at) * 1000),
            "connect_timeout_ms": connect_timeout_ms,
        },
    )
    if stage_callback is not None:
        stage_callback("completed")
    return adapted
