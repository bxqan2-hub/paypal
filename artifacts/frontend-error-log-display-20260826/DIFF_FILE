+        raw,
+      };
+    }
+    if (/Proxy CONNECT aborted|proxy.*timeout|Sentinel.*超时|Failed to connect/i.test(raw)) {
+      return {
+        kind: "network",
+        title: "代理连接未完成",
+        detail: "代理未能完成 Checkout 或 Sentinel 连接。",
+        hint: "先测试当前代理 IP，再更换可用线路重试。",
+        raw,
+      };
+    }
+    if (/invalid proxy|proxy_pool/i.test(raw)) {
+      return {
+        kind: "proxy-input",
+        title: "代理池格式无效",
+        detail: "代理池中存在空格、备注或无法识别的代理行。",
+        hint: "每行填写一条代理，不要添加行内备注。",
+        raw,
+      };
