+def _agent_browser_binary() -> str:
+    """Locate the optional native agent-browser executable."""
+    configured = os.getenv("OPLL_AGENT_BROWSER_BIN", "").strip()
+    if configured and Path(configured).exists():
+        return configured
+    if sys.platform == "win32":
