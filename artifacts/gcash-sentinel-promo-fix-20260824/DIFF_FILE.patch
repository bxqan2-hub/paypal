+            / "AppData"
+            / "Roaming"
+            / "npm"
+            / "node_modules"
+            / "agent-browser"
+            / "bin"
+            / "agent-browser-win32-x64.exe",
+            Path(sys.prefix)
+            / "node_modules"
+            / "agent-browser"
+            / "bin"
+            / "agent-browser-win32-x64.exe",
+        )
