+                    raise RuntimeError("真实支付页未进入 GCash")
+
+                expires_at = int(time.time()) + MONITOR_TTL_SECONDS
+                self._audit(
+                    monitor_id,
+                    "gcash_link_ready",
+                    route=_route_label(gcash_link),
+                    expires_at=expires_at,
+                )
+                self._update(
+                    monitor_id,
+                    status="waiting_scan",
