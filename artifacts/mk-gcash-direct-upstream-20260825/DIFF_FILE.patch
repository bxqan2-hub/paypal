+  const steps = account.steps || [];
+  const activeIndex = steps.findIndex(step => step.state === "active");
+  if (activeIndex < 0) return 12;
+  return Math.max(12, Math.min(92, Math.round(((activeIndex + 1) / Math.max(1, steps.length)) * 90)));
