+        ):
+            self.assertNotIn(private, rendered)
+        self.assertTrue(public["link_ready"])
+        self.assertTrue(public["qr_ready"])
+
+    def test_abandon_account_releases_monitor_and_returns_public_state(self):
+        client_id = "acct_0123456789abcdef"
