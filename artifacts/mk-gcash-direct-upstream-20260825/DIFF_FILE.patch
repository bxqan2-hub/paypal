+
+                phase = "gcash_discovery"
+                gcash_link = ""
+                deadline = time.monotonic() + 60
+                while time.monotonic() < deadline and not gcash_link:
+                    gcash_link = _gcash_url(page.url)
+                    if not gcash_link:
