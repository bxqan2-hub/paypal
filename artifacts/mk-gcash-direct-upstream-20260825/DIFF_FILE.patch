index 0000000..93ee667
--- /dev/null
+++ b/payment_link_extractor/mk_gcash_open_source/web/index.html
@@ -0,0 +1,174 @@
+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <meta name="color-scheme" content="light">
+  <title>MK提链 · 开源版</title>
+  <link rel="icon" href="assets/mikael-mail-logo.webp" type="image/webp">
+  <link rel="stylesheet" href="style.css?v=20260824-openui01">
+</head>
+<body>
+  <header class="titlebar">
+    <a class="brand" href="/" aria-label="MK提链首页">
+      <img src="assets/mikael-mail-logo.webp" width="34" height="34" alt="MK">
+      <strong>MK提链 <span>开源版</span></strong>
+    </a>
+    <div class="titleActions">
+      <div class="queueState checking" id="queueStatus" aria-live="polite">
+        <i></i><span>服务检查中</span>
+      </div>
+      <div class="topStat"><b id="accountCount">0</b><span>账号</span></div>
+      <span class="repoLink">本地模式</span>
+    </div>
+  </header>
+
+  <nav class="steps" aria-label="任务步骤">
+    <button class="step active" type="button" data-step="1">
+      <span class="stepNum">1</span>
+      <b>导入账号</b>
+      <span class="stepState" id="stepState1">当前</span>
+    </button>
+    <span class="connector"></span>
+    <button class="step" type="button" data-step="2">
+      <span class="stepNum">2</span>
+      <b>确认账号与提链</b>
+      <span class="stepState" id="stepState2">0</span>
+    </button>
+  </nav>
+
+  <main class="workspace">
+    <section class="stage active" id="stage1">
+      <div class="stageHeader">
+        <div>
+          <span class="eyebrow">本地任务</span>
+          <h1>导入账号</h1>
+        </div>
+        <span class="capacity" id="inputCounter">0 个账号 · 0 个节点</span>
+      </div>
+
+      <div class="importGrid">
+        <section class="inputPane panel">
+          <div class="panelTitle">
+            <div><b>粘贴 AT</b><span>Bearer / Authorization / email|AT</span></div>
+            <span class="muted" id="importStatus">等待导入</span>
+          </div>
+          <textarea id="tokenInput" spellcheck="false" autocomplete="off" placeholder="每行一个 AT，可使用 email@example.com|eyJ..."></textarea>
+          <div class="buttonRow">
+            <label class="button secondary fileButton">选择 TXT<input id="txtFile" type="file" accept=".txt,text/plain"></label>
+            <button class="secondary" id="clearToken" type="button">清空</button>
+            <span class="grow"></span>
+            <button class="primary actionButton" id="importTokenBtn" type="button">解析账号</button>
+          </div>
+        </section>
+
+        <aside class="proxyPane panel">
+          <div class="panelTitle">
+            <div><b>PH 住宅代理池</b><span>仅使用自备节点</span></div>
+            <span class="proxyCount" id="proxyCount">0 / 100</span>
+          </div>
