+// ---- PoW（对齐 sentinel.go：configArray(answer=true) + fnv1a32 + b64） ----
+function fnv1a32(buf) {
+  let h = 0x811c9dc5 >>> 0;
+  for (let i = 0; i < buf.length; i++) {
+    h ^= buf[i];
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
