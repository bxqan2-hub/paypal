+    null, // 6
+    g.language, // 7
+    g.languages.join(","), // 8
+    g.nine, // 9
+    g.probeNav, // 10
+    g.reactKey, // 11
+    g.eventName, // 12
+    perfNow, // 13
+    g.sid, // 14
+    "", // 15
+    g.cores, // 16
+    g.loadTs, // 17
+    0, 0, 0, 0, 0, 0, 0, // 18..24
