+            or ""
+        )
+        cookie_names = sorted(
+            {
+                item.split("=", 1)[0].strip()
+                for item in cookie_header.split(";")
+                if "=" in item and item.split("=", 1)[0].strip()
+            }
+        )
+        has_session_token = any(
+            name == "__Secure-next-auth.session-token"
+            or name.startswith("__Secure-next-auth.session-token.")
