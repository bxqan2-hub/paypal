@@ -101 +101 @@ FULL_LOGS_UI_ENABLED = env_bool("PAYPAL_WEB_FULL_LOGS_UI", False)
-ENABLE_DYNAMIC_COUNTRIES = env_bool("PAYPAL_WEB_ENABLE_DYNAMIC_COUNTRIES", False)
+ENABLE_DYNAMIC_COUNTRIES = env_bool("PAYPAL_WEB_ENABLE_DYNAMIC_COUNTRIES", True)
@@ -2048,0 +2049,24 @@ VERIFIED_PROTOCOL_COUNTRIES = {"BR", "GB", "US", "JP", "TH", "ID", "PH", "TW", "
+def dynamic_schema_country_codes() -> set[str]:
+    """Return the locally catalogued dynamic countries that PayPal supports."""
+    try:
+        catalog_path = ROOT / "data" / "country_discovery" / "country_field_catalog.json"
+        catalog = json.loads(catalog_path.read_text(encoding="utf-8"))
+        if not isinstance(catalog, dict):
+            return set()
+        catalog_codes = {
+            str(code or "").strip().upper()
+            for code in catalog
+            if re.fullmatch(r"[A-Z]{2}", str(code or "").strip().upper())
+        }
+        return catalog_codes & supported_country_codes()
+    except Exception:
+        return set()
+
+
+def enabled_protocol_country_codes() -> set[str]:
+    """Return the countries allowed by the current protocol feature flag."""
+    if not ENABLE_DYNAMIC_COUNTRIES:
+        return set(VERIFIED_PROTOCOL_COUNTRIES)
+    return set(VERIFIED_PROTOCOL_COUNTRIES) | dynamic_schema_country_codes()
+
+
@@ -2104 +2128 @@ def create_job(
-    allowed_countries = supported_country_codes() if ENABLE_DYNAMIC_COUNTRIES else VERIFIED_PROTOCOL_COUNTRIES
+    allowed_countries = enabled_protocol_country_codes()
@@ -2619,0 +2644,7 @@ class WebHandler(BaseHTTPRequestHandler):
+            enabled_codes = enabled_protocol_country_codes()
+            countries = [
+                item for item in countries or []
+                if isinstance(item, dict)
+                and str(item.get("code") or "").strip().upper() in enabled_codes
+            ]
+            payload["countries"] = countries
@@ -2620,0 +2652 @@ class WebHandler(BaseHTTPRequestHandler):
+            payload["enabled_country_count"] = len(countries)
